500 0 obj
<</Type/Annot/Subtype/Widget/V(Pump Cuts )/F 132/C[1 0 0]/FT/Tx/M(D:20260615102326-04'00')/MK<</IF<</A[0 0]>>>>/AP<</N 302 0 R>>/DA(0 0 0 rg /Calibri 9 Tf)/T(SUBMITTAL DESCRIPTION [579])/Ff 33554432/Rect[174.4259 431.067 561.2596 443.5305]/DV()/BS 264 0 R/DS(font: Calibri 9pt; text-align:left; text-valign:middle; line-height:10.35pt; color:#000000)/RV(<?xml version="1.0"?><body xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:contentType="text/html" xfa:APIVersion="BluebeamPDFRevu:2018" xfa:spec="2.2.0" style="font:9pt Calibri; text-align:left; line-height:10.35pt; color:#000000; text-valign:middle" xmlns="http://www.w3.org/1999/xhtml"><p style="font-family:Calibri">Pump Cuts </p></body>)>>
